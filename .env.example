PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-local-mysql-password
DB_NAME=qrankdb
DB_PORT=3306
DB_SSL=false
DB_CONNECTION_LIMIT=10

COOKIE_SECRET=generate-a-long-random-string
CRON_SECRET=generate-a-long-random-string

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=QRank <your-email@gmail.com>
SMTP_SECURE=false
RESET_CODE_TTL_MINUTES=15
DEV_PASSWORD_RESET_FALLBACK=true

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
DESMOS_API_KEY=your-desmos-api-key

SYNC_TARGET_HOST=
SYNC_TARGET_PORT=4000
SYNC_TARGET_USER=
SYNC_TARGET_PASSWORD=
SYNC_TARGET_NAME=
SYNC_TARGET_SSL=true
